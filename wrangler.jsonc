{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blockmarshal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The built client (vite build). The Worker only runs for the API and game sockets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" }
    ]
  },
  // The Workers Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchDO", "MatchmakerDO"] }],
  // Private store for in-game feedback. Read it from the dashboard or `npm run feedback`; there is no public read route.
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "blockmarshal-feedback",
      "database_id": "1c190ab0-3a9d-4927-9ffe-aa4f87bf9086",
      "migrations_dir": "migrations"
    }
  ],
  // Lobby countdown. Override locally in .dev.vars (e.g. LOBBY_SECONDS=0 to start solo games instantly).
  // FEEDBACK_EMAIL gets a copy of each feedback form, sent via Resend once the
  // RESEND_API_KEY secret is set (`npx wrangler secret put RESEND_API_KEY`).
  // FEEDBACK_EMAIL and RESEND_API_KEY are Worker secrets (`wrangler secret put`), not vars: the repo is public.
  // BUILD: git hash stamped on server replays; scripts/deploy.mjs overrides "dev" with --var.
  "vars": { "LOBBY_SECONDS": "60", "BUILD": "dev" },
  // Per-IP request limits (counted per Cloudflare location). Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "REPLAY_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  // Daily clean-up of old replays (03:17 UTC).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}

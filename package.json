{
  "name": "blockmarshal",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "server": "wrangler dev --port 8787",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "feedback": "wrangler d1 execute blockmarshal-feedback --remote --command \"SELECT id, created_at, rating, confusing, improve, context FROM feedback ORDER BY id DESC LIMIT 50\"",
    "db:migrate": "wrangler d1 migrations apply blockmarshal-feedback --remote",
    "db:migrate:local": "wrangler d1 migrations apply blockmarshal-feedback --local",
    "replays": "node scripts/pull-replays.mjs",
    "sounds": "node scripts/make-sounds.mjs",
    "video:setup": "npm install --prefix tools/video",
    "video": "node tools/video/render.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}

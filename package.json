{
  "name": "blockmarshal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "server": "wrangler dev --port 8787",
    "types": "wrangler types worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
